<Window x:Class="NuShaders.GUI.Views.CreateTextureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create texture" Height="520" Width="560" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
    </Window.Resources>
    <StackPanel Margin="12">
        <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" TextWrapping="Wrap" />

        <!-- Diffuse inputs -->
        <StackPanel Visibility="{Binding IsDiffuse, Converter={StaticResource B2V}}">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Albedo.Label}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding Albedo.Path, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                <Button Grid.Column="2" Content="Browse…" Padding="8,1" Margin="4,0,0,0" Tag="{Binding Albedo}" Click="Browse_Click" />
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Opacity.Label}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding Opacity.Path, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                <Button Grid.Column="2" Content="Browse…" Padding="8,1" Margin="4,0,0,0" Tag="{Binding Opacity}" Click="Browse_Click" />
            </Grid>
        </StackPanel>

        <!-- Spec inputs: ORM / Specular toggle -->
        <StackPanel Visibility="{Binding IsSpec, Converter={StaticResource B2V}}">
            <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                <TextBlock Text="Packing" VerticalAlignment="Center" Width="120" />
                <RadioButton Content="ORM (AO / rough / metal / height)" GroupName="specmode" VerticalAlignment="Center" IsChecked="{Binding ORMChecked}" />
                <RadioButton Content="Specular (grayscale mask)" GroupName="specmode" VerticalAlignment="Center" Margin="16,0,0,0" IsChecked="{Binding SpecularChecked}" />
            </StackPanel>

            <!-- ORM inputs -->
            <StackPanel Visibility="{Binding IsSpecORM, Converter={StaticResource B2V}}">
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding AO.Label}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding AO.Path, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                    <Button Grid.Column="2" Content="Browse…" Padding="8,1" Margin="4,0,0,0" Tag="{Binding AO}" Click="Browse_Click" />
                </Grid>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Roughness.Label}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding Roughness.Path, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                    <Button Grid.Column="2" Content="Browse…" Padding="8,1" Margin="4,0,0,0" Tag="{Binding Roughness}" Click="Browse_Click" />
                </Grid>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Metallic.Label}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding Metallic.Path, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                    <Button Grid.Column="2" Content="Browse…" Padding="8,1" Margin="4,0,0,0" Tag="{Binding Metallic}" Click="Browse_Click" />
                </Grid>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Displacement.Label}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding Displacement.Path, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                    <Button Grid.Column="2" Content="Browse…" Padding="8,1" Margin="4,0,0,0" Tag="{Binding Displacement}" Click="Browse_Click" />
                </Grid>
            </StackPanel>

            <!-- Specular input -->
            <StackPanel Visibility="{Binding IsSpecSpecular, Converter={StaticResource B2V}}">
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Specular.Label}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding Specular.Path, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                    <Button Grid.Column="2" Content="Browse…" Padding="8,1" Margin="4,0,0,0" Tag="{Binding Specular}" Click="Browse_Click" />
                </Grid>
            </StackPanel>
        </StackPanel>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Format" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" Width="140" ItemsSource="{Binding Formats}" SelectedItem="{Binding Format}" />
            <CheckBox Grid.Column="2" Content="Generate mips" IsChecked="{Binding GenerateMips}" VerticalAlignment="Center" Margin="12,0,0,0" />
        </Grid>

        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Texture name" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding TextureName, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
        </Grid>

        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Target bundle" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Bundles}" SelectedItem="{Binding TargetBundle}" DisplayMemberPath="Name"
                      ToolTip="Which loaded bundle to write the new texture into (e.g. a WORLDTEX bundle)" />
        </Grid>

        <TextBox Height="70" Margin="0,10,0,0" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="{Binding Log, Mode=OneWay}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" Width="90" Padding="8,3" Click="Cancel_Click" />
            <Button Content="Create &amp; Assign" Width="130" Padding="8,3" Margin="8,0,0,0" FontWeight="Bold" Command="{Binding CreateCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
