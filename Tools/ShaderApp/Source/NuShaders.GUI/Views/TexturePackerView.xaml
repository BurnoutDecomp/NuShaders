<UserControl x:Class="NuShaders.GUI.Views.TexturePackerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:NuShaders.GUI.ViewModels">
    <UserControl.DataContext>
        <vm:TexturePackerViewModel />
    </UserControl.DataContext>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="170" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Pack PBR maps into a BPR texture set: albedo → Diffuse (RGB), and AO/Roughness/Metallic/Displacement → Spec (R/G/B/A). Produces Texture + TextureState resources and a .meta.yaml." />

                <GroupBox Header="Source maps (PNG / TGA / BMP / JPG)" Padding="6">
                    <ItemsControl ItemsSource="{Binding Maps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" />
                                    <TextBox Grid.Column="1" Margin="4,0" VerticalContentAlignment="Center"
                                             Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="2" Content="Browse…" Padding="10,2" Click="BrowseMap_Click" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </GroupBox>

                <GroupBox Header="Encoding" Padding="6" Margin="0,6,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="Diffuse format" Width="160" VerticalAlignment="Center" />
                            <ComboBox Width="150" ItemsSource="{Binding DiffuseFormats}" SelectedItem="{Binding DiffuseFormat}" />
                            <TextBlock Text="Spec format" Width="90" Margin="20,0,0,0" VerticalAlignment="Center" />
                            <ComboBox Width="150" ItemsSource="{Binding SpecFormats}" SelectedItem="{Binding SpecFormat}" />
                        </StackPanel>
                        <CheckBox Content="Generate mipmaps" IsChecked="{Binding GenerateMips}" Margin="0,4" />
                    </StackPanel>
                </GroupBox>

                <Expander Header="Sampler (advanced)" Margin="0,6,0,0">
                    <StackPanel Margin="6">
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="Address mode" Width="160" VerticalAlignment="Center" />
                            <ComboBox Width="150" ItemsSource="{Binding AddressModes}" SelectedItem="{Binding AddressMode}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <CheckBox Content="Anisotropic filtering" Width="160" IsChecked="{Binding Anisotropic}" VerticalAlignment="Center" />
                            <ComboBox Width="80" ItemsSource="{Binding AnisotropyLevels}" SelectedItem="{Binding MaxAnisotropy}" IsEnabled="{Binding Anisotropic}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="Mip LOD bias" Width="160" VerticalAlignment="Center" />
                            <TextBox Width="80" Text="{Binding LodBias}" />
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Foreground="Gray" FontSize="11" Margin="0,4,0,0"
                                   Text="Sampler options are written to the TextureState binary only; they do not change the resource id." />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <GroupBox Grid.Row="1" Header="Output" Padding="6" Margin="0,6,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2">
                    <TextBlock Text="Material name" Width="160" VerticalAlignment="Center" />
                    <TextBox Width="280" VerticalContentAlignment="Center"
                             Text="{Binding MaterialName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Output folder" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Margin="4,0" VerticalContentAlignment="Center"
                             Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="2" Content="Browse…" Padding="10,2" Click="BrowseOutput_Click" />
                </Grid>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" Content="Merge into bundle" IsChecked="{Binding MergeIntoBundle}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Margin="4,0" VerticalContentAlignment="Center"
                             IsEnabled="{Binding MergeIntoBundle}"
                             Text="{Binding BundleFolder, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="2" Content="Browse…" Padding="10,2" Click="BrowseBundle_Click" IsEnabled="{Binding MergeIntoBundle}" />
                </Grid>
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8">
            <Button Content="Pack" Width="120" Height="30" Command="{Binding PackCommand}" FontWeight="Bold" />
            <ProgressBar Width="220" Height="20" Margin="12,0,0,0" IsIndeterminate="{Binding IsBusy}" />
        </StackPanel>

        <TextBox Grid.Row="3" Margin="0,4,0,0" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" Text="{Binding Log, Mode=OneWay}" />
    </Grid>
</UserControl>
