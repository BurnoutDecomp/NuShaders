<UserControl x:Class="NuShaders.GUI.Views.MaterialEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
        <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute" Stretch="None">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFFFF">
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,16,16" /></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#CCCCCC">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,8,8" />
                                <RectangleGeometry Rect="8,8,8,8" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>

    <TabControl Margin="4">
        <!-- ===================== MATERIALS ===================== -->
        <TabItem Header="Materials">
            <Grid Margin="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="290" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0" Margin="0,0,6,0">
                    <TextBlock DockPanel.Dock="Top" Text="Materials" FontWeight="Bold" Margin="0,0,0,4" />
                    <Grid DockPanel.Dock="Bottom" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                                 ToolTip="Assign a name to the selected material (saved to .debug.xml)" />
                        <Button Grid.Column="1" Content="Rename" Padding="8,2" Margin="4,0,0,0" Command="{Binding RenameCommand}" />
                    </Grid>
                    <ListBox ItemsSource="{Binding Workspace.Materials}" SelectedItem="{Binding SelectedMaterial}" DisplayMemberPath="ShortName"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="ToolTip" Value="{Binding DisplayName}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <GroupBox Header="Shader" Padding="6">
                                <StackPanel>
                                    <ComboBox ItemsSource="{Binding Workspace.Shaders}" SelectedItem="{Binding SelectedShader}" DisplayMemberPath="ShortName" />
                                    <TextBlock Text="{Binding ShaderStatus}" Foreground="Gray" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Render mode" Padding="6" Margin="0,6,0,0">
                                <ItemsControl ItemsSource="{Binding Techniques}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="{Binding TechniqueIndex, StringFormat='Technique {0}'}" Width="110" VerticalAlignment="Center" />
                                                <ComboBox Width="360" ItemsSource="{Binding MaterialStateChoices}" SelectedItem="{Binding SelectedMaterialState}" DisplayMemberPath="ShortName" />
                                                <TextBlock Text="{Binding RenderModeLabel}" Foreground="SteelBlue" VerticalAlignment="Center" Margin="10,0,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </GroupBox>

                            <GroupBox Header="Texture samplers" Padding="6" Margin="0,6,0,0">
                                <ItemsControl ItemsSource="{Binding Samplers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#EEE" BorderThickness="0,0,0,1" Padding="0,5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="62" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="54" Height="54" VerticalAlignment="Top"
                                                            Background="{StaticResource Checker}" BorderBrush="#888" BorderThickness="1">
                                                        <Border.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="Export as DDS…" Click="ExportDDSSampler_Click" />
                                                            </ContextMenu>
                                                        </Border.ContextMenu>
                                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Channel, StringFormat='ch{0}'}" Width="40" VerticalAlignment="Center" Foreground="Gray" />
                                                            <TextBlock Text="{Binding ShaderSamplerName}" Width="150" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding TextureName}" Width="210" VerticalAlignment="Center" Foreground="#333" TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding TextureFullName}" />
                                                            <Button Content="Browse…" Padding="8,1" Margin="4,0,0,0" Click="BrowseTexture_Click" />
                                                            <Button Content="+ Create" Padding="8,1" Margin="4,0,0,0" Click="CreateTexture_Click"
                                                                    Visibility="{Binding CanCreate, Converter={StaticResource B2V}}"
                                                                    ToolTip="Pack a new texture for this slot and assign it." />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="40,4,0,0">
                                                            <TextBlock Text="Wrap" VerticalAlignment="Center" Foreground="Gray" />
                                                            <ComboBox Width="78" Margin="4,0,0,0" ItemsSource="{Binding AddressModes}" SelectedItem="{Binding AddressU}" ToolTip="Address U" />
                                                            <ComboBox Width="78" Margin="3,0,0,0" ItemsSource="{Binding AddressModes}" SelectedItem="{Binding AddressV}" ToolTip="Address V" />
                                                            <ComboBox Width="78" Margin="3,0,0,0" ItemsSource="{Binding AddressModes}" SelectedItem="{Binding AddressW}" ToolTip="Address W" />
                                                            <TextBlock Text="Filter" VerticalAlignment="Center" Foreground="Gray" Margin="10,0,0,0" />
                                                            <ComboBox Width="98" Margin="4,0,0,0" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" />
                                                            <TextBlock Text="Aniso" VerticalAlignment="Center" Foreground="Gray" Margin="10,0,0,0" />
                                                            <TextBox Width="40" Margin="4,0,0,0" Text="{Binding MaxAnisotropy}" VerticalContentAlignment="Center" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </GroupBox>

                            <GroupBox Header="Parameters" Padding="6" Margin="0,6,0,0">
                                <ItemsControl ItemsSource="{Binding Parameters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="200" />
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Stage}" VerticalAlignment="Center" Foreground="Gray" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding DefaultText, StringFormat='default: {0}'}" />
                                                <Border Grid.Column="2" Width="40" Height="18" Margin="0,0,4,0" Cursor="Hand"
                                                        BorderBrush="#888" BorderThickness="1" Background="{Binding SwatchBrush}"
                                                        MouseLeftButtonUp="Swatch_Click"
                                                        Visibility="{Binding IsColor, Converter={StaticResource B2V}}"
                                                        ToolTip="Edit as colour" />
                                                <TextBox Grid.Column="3" Text="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Margin="2,0" />
                                                <Button Grid.Column="4" Content="Reset" Padding="6,1" Click="ResetParam_Click" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Margin="0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Output folder" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox Grid.Column="1" Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                            <Button Grid.Column="2" Content="Browse…" Padding="10,2" Margin="4,0,0,0" Click="BrowseOutput_Click" />
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="New material name" VerticalAlignment="Center" Margin="0,0,6,0"
                                       ToolTip="Create a new material as a byte-clone of the selected one (with your edits) under a new id — engine-safe." />
                            <TextBox Grid.Column="1" Text="{Binding NewMaterialName, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                        </Grid>
                        <Menu Margin="0,8,0,0" HorizontalAlignment="Left" Background="Transparent">
                            <MenuItem Padding="14,4" FontWeight="Bold">
                                <MenuItem.Header><TextBlock Text="Save  ▾" /></MenuItem.Header>
                                <MenuItem Header="Save to output folder (standalone, non-destructive)" Command="{Binding SaveCommand}" />
                                <Separator />
                                <MenuItem Header="Merge into…" ItemsSource="{Binding MergeTargets}">
                                    <MenuItem.ItemContainerStyle>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Header" Value="{Binding Name}" />
                                            <Setter Property="Command" Value="{Binding Command}" />
                                        </Style>
                                    </MenuItem.ItemContainerStyle>
                                </MenuItem>
                                <MenuItem Header="Merge into another bundle…" Click="MergeIntoOther_Click" />
                                <Separator />
                                <MenuItem Header="Save as new material…" Command="{Binding SaveAsNewCommand}" />
                            </MenuItem>
                        </Menu>
                        <TextBlock Text="{Binding Log}" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" MaxHeight="44" />
                    </StackPanel>
                </Grid>
            </Grid>
        </TabItem>

        <!-- ===================== TEXTURES ===================== -->
        <TabItem Header="Textures">
            <Grid Margin="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="290" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0" Margin="0,0,6,0">
                    <TextBlock DockPanel.Dock="Top" Text="Textures" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBox DockPanel.Dock="Top" Margin="0,0,0,4" VerticalContentAlignment="Center"
                             Text="{Binding TexturePreview.FilterText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter textures by name" />
                    <ListBox ItemsSource="{Binding TexturePreview.ItemsView}" SelectedItem="{Binding TexturePreview.SelectedTexture}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="ToolTip" Value="{Binding DisplayName}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ShortName}" TextTrimming="CharacterEllipsis" Background="Transparent">
                                    <TextBlock.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Export as DDS…" Click="ExportDDSTexture_Click" />
                                        </ContextMenu>
                                    </TextBlock.ContextMenu>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <DockPanel Grid.Column="1" Margin="4,0,0,0">
                    <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Name" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Grid.Column="1" Text="{Binding TexturePreview.RenameText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                                 ToolTip="Assign a name to this texture (saved to its bundle's .debug.xml)" />
                        <Button Grid.Column="2" Content="Rename" Padding="8,2" Margin="6,0,0,0" Command="{Binding TexturePreview.RenameCommand}" />
                    </Grid>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <TextBlock Text="{Binding TexturePreview.Name}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding TexturePreview.SelectedTexture.DisplayName}" />
                        <TextBlock Text="{Binding TexturePreview.Info}" Foreground="Gray" Margin="0,3,0,0" />
                    </StackPanel>
                    <Border Background="{StaticResource Checker}" BorderBrush="#888" BorderThickness="1">
                        <Image Source="{Binding TexturePreview.Preview}" Stretch="Uniform" Margin="4"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                </DockPanel>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
