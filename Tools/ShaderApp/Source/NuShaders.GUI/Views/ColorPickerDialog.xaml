<Window x:Class="NuShaders.GUI.Views.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit colour" Height="320" Width="380" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Window.Resources>
        <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute" Stretch="None">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFFFF">
                        <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,16,16" /></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#CCCCCC">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,8,8" />
                                <RectangleGeometry Rect="8,8,8,8" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <StackPanel Margin="12">
        <Border Height="48" BorderBrush="#888" BorderThickness="1" Background="{StaticResource Checker}">
            <Rectangle Fill="{Binding PreviewBrush}" />
        </Border>

        <Grid Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="64" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="R" VerticalAlignment="Center" />
            <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="{Binding SliderMax}" Value="{Binding R}" VerticalAlignment="Center" Margin="0,3" />
            <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding R, StringFormat=0.####, UpdateSourceTrigger=LostFocus}" Margin="4,3,0,3" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="G" VerticalAlignment="Center" />
            <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="{Binding SliderMax}" Value="{Binding G}" VerticalAlignment="Center" Margin="0,3" />
            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding G, StringFormat=0.####, UpdateSourceTrigger=LostFocus}" Margin="4,3,0,3" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="B" VerticalAlignment="Center" />
            <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="{Binding SliderMax}" Value="{Binding B}" VerticalAlignment="Center" Margin="0,3" />
            <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding B, StringFormat=0.####, UpdateSourceTrigger=LostFocus}" Margin="4,3,0,3" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="A" VerticalAlignment="Center" />
            <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="{Binding SliderMax}" Value="{Binding A}" VerticalAlignment="Center" Margin="0,3" />
            <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding A, StringFormat=0.####, UpdateSourceTrigger=LostFocus}" Margin="4,3,0,3" />
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="Hex #" VerticalAlignment="Center" />
            <TextBox Text="{Binding Hex}" Width="90" Margin="6,0,0,0" CharacterCasing="Upper" />
            <TextBlock Text="(RGB)" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="Gray" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="84" Padding="8,3" Command="{Binding CancelCommand}" />
            <Button Content="OK" Width="84" Padding="8,3" Margin="8,0,0,0" FontWeight="Bold" Command="{Binding OkCommand}" />
        </StackPanel>
    </StackPanel>
</Window>
