<Window x:Class="NuShaders.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NuShaders.GUI.Views"
        Title="NuShaders Material Studio" Height="820" Width="1040">
    <DockPanel Margin="6">
        <Border DockPanel.Dock="Top" Padding="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <Button Content="Open Bundle…" Padding="12,3" Click="OpenBundle_Click" />
                <TextBlock Text="{Binding Workspace.BundleFolder}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="Gray" />
                <Button Content="Add Reference Bundle(s)…" Padding="12,3" Margin="20,0,0,0" Click="AddReferenceBundle_Click"
                        ToolTip="Add other extracted bundles (SHADERS, WORLDTEX0-3, texture dictionaries…) — their textures, shaders and states feed the texture browser, pick-lists and name resolution. Select several at once." />
                <TextBlock Text="{Binding Workspace.ReferenceBundles}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="SteelBlue" />
            </StackPanel>
        </Border>
        <views:MaterialEditorView DataContext="{Binding MaterialEditor}" />
    </DockPanel>
</Window>
